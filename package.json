{
  "name": "elemental",
  "version": "0.1.0",
  "private": true,
  "description": "ELEMENTAL: a high-fantasy, physics-driven mobile action-adventure. Phase 1 technical prototype.",
  "scripts": {
    "serve": "npx --yes http-server -p 8140 -s -c-1 .",
    "check": "bash qa/parsecheck.sh src",
    "smoke": "node qa/smoke.js",
    "sheet": "node qa/modelsheet.js",
    "lesson": "node qa/lesson.js",
    "core": "node qa/core.js",
    "creatures": "node qa/creatures.js",
    "prologue": "node qa/prologue.js",
    "abilities": "node qa/abilities.js",
    "terrain": "node qa/terrain.js",
    "bestiary": "node qa/bestiary.js",
    "world": "node qa/world.js",
    "movement": "node qa/movement.js",
    "swim": "node qa/swim.js",
    "talk": "node qa/talk.js",
    "gate": "node qa/gate.js",
    "thornwick": "node qa/thornwick.js",
    "ruin": "node qa/ruin.js",
    "yard": "node qa/yard.js",
    "cistern": "node qa/cistern.js",
    "saltmere": "node qa/saltmere.js",
    "resume": "node qa/resume.js",
    "juice": "node qa/juice.js",
    "particles": "node qa/particles.js",
    "elementfx": "node qa/elementfx.js",
    "buildings": "node qa/buildings.js",
    "bench": "node qa/bench.js",
    "unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON qa/unit.mjs",
    "scenes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-scenes.mjs",
    "scene:veyra": "node scripts/scenes/veyra.mjs",
    "scenes:build": "for s in veyra gate verdant cistern emberwall saltmere skyreach glass halcyra testlands gallery bestiary; do node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scenes/$s.mjs || exit 1; done",
    "build:web": "node scripts/build-web.js",
    "cap:sync": "npm run build:web && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
