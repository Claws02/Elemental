      "do": [
       {
        "flag": {
         "name": "caelTrust",
         "add": -1
        }
       },
       {
        "saveFlag": "lesson1"
       },
       {
        "do": {
         "obj": "Lesson1_WeightL",
         "action": "hintOff"
        }
       },
       {
        "do": {
         "obj": "Lesson1_WeightR",
         "action": "hintOff"
        }
       }
      ],
      "say": [
       "It's open. So is everything else, now.",
       "Power isn't the hard part. You'll find that out.",
       "Rest. Tomorrow, we do it again."
      ]
     },
     {
      "when": {
       "any": [
        {
         "signal": {
          "obj": "TestRoom_Barricade_01",
          "name": "raised"
         }
        },
        {
         "signal": {
          "obj": "TestRoom_Barricade_01",
          "name": "broken"
         }
        }
       ]
      },
