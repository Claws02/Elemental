 "script": {
  "id": "Lesson1",
  "speaker": "Cael",
  "face": "Cael",
  "flags": {
   "caelTrust": 0
  },
  "reactions": [
   {
    "on": "playerFire",
    "count": "fireSeen",
    "flag": {
     "name": "caelTrust",
     "add": -1
    },
    "throttle": 12,
    "lines": [
     [
      "Put it out."
     ],
     [
      "Fire again."
     ],
     [
      "Every time you reach for that, something burns that didn’t have to."
     ],
     [
      "Stop."
     ]
    ],
    "followUp": {
     "after": 4,
     "firstOnly": true,
     "if": {
      "burning": true
     },
     "say": [
      "You can't, can you. That's why we don't start there."
     ]
    }
   },
   {
    "on": "tooHeavy",
    "count": "tooHeavy",
    "throttle": 6,
    "cycle": true,
    "lines": [
     [
      "Too heavy. You're not ready for that one."
     ],
     [
      "Not that one. It is beyond you, for now."
     ]
    ]
   },
   {
    "on": "playerSurge",
    "throttle": 25,
    "lines": [
     [
      "That wasn't you choosing. That was it choosing for you."
     ],
     [
      "The charm is in your pocket. It isn't a punishment."
     ],
     [
      "Breathe. It answers you. Even when you don't ask."
     ]
    ]
   }
  ],
  "steps": [
   {
    "id": "intro",
    "say": [
     "So. The fire in Veyra. That was you.",
     "Fire is the loudest thing in you. We are not starting there.",
     "Earth. It doesn't rush. Neither will you.",
     "That stone. Lift it."
    ],
    "until": {
     "talking": false
    }
   },
   {
    "id": "lift",
    "objective": "Lift the marked stone",
    "mark": "TestRoom_Rock_02",
    "until": {
     "held": "TestRoom_Rock_02"
    },
    "then": {
     "say": [
      "Good. Now hold it. Don't fight it. Feel where it wants to fall."
     ]
    }
   },
   {
    "id": "steady",
    "objective": "Hold it steady · {held} / 3 s",
    "until": {
     "heldFor": {
      "obj": "TestRoom_Rock_02",
      "secs": 3,
      "lost": [
       "Again. Slower."
      ]
     }
    },
    "then": {
     "do": [
      {
       "grant": {
        "el": "earth",
        "track": "control",
        "amount": 0.15
       }
      }
     ],
     "say": [
      "Steadier.",
      "Now set it down on the plate. Set it. Don’t drop it."
     ]
    }
   },
   {
    "id": "place",
    "objective": "Set it down on the plate",
    "mark": "Lesson1_Plate",
    "do": [
     {
      "do": {
       "obj": "Lesson1_Plate",
       "action": "hintOn"
      }
     }
    ],
    "waiting": [
     {
      "when": {
       "all": [
        {
         "signal": {
          "obj": "Lesson1_Plate",
          "name": "weighted"
         }
        },
        {
         "not": {
          "signal": {
           "obj": "Lesson1_Plate",
           "name": "gentle"
          }
         }
        }
       ]
      },
      "say": [
       "That was a drop. Pick it up. Again."
      ]
     }
    ],
    "until": {
     "signal": {
      "obj": "Lesson1_Plate",
      "name": "gentle"
     }
    },
    "then": {
     "do": [
      {
       "do": {
        "obj": "Lesson1_Plate",
        "action": "hintOff"
       }
      },
      {
       "grant": {
        "el": "earth",
        "track": "control",
        "amount": 0.15
       }
      },
      {
       "reveal": [
        "TestRoom_Rock_01",
        "TestRoom_Rock_04",
        "TestRoom_Rock_05",
        "TestRoom_Rock_07",
        "TestRoom_Rock_08",
        "TestRoom_Rock_09",
        "TestRoom_Rock_10"
       ]
      }
     ],
     "say": [
      "There.",
      "Stone remembers how it was treated. So do people.",
      "More stones. Some you can lift. Some you can’t, yet."
     ]
    }
   },
   {
    "id": "trialIntro",
    "until": {
     "talking": false
    }
   },
   {
    "id": "trial",
    "objective": "Open the sealed passage",
    "say": [
     "The passage is sealed. You could break it. You probably want to.",
     "There's a way through that leaves it standing. Find it."
    ],
    "waiting": [
     {
      "when": {
       "time": 20
      },
      "do": [
       {
        "do": {
         "obj": "Lesson1_WeightL",
         "action": "hintOn"
        }
       },
       {
        "do": {
         "obj": "Lesson1_WeightR",
         "action": "hintOn"
        }
       }
      ]
     }
    ],
    "ends": [
     {
      "when": {
       "all": [
        {
         "any": [
          {
