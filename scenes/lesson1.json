      "do": [
       {
        "flag": {
         "name": "caelTrust",
         "add": -1
        }
       },
       {
        "saveFlag": "lesson1"
       },
       {
        "do": {
         "obj": "Lesson1_WeightL",
         "action": "hintOff"
        }
       },
       {
        "do": {
         "obj": "Lesson1_WeightR",
         "action": "hintOff"
        }
       }
      ],
      "say": [
       "I said we were not starting with fire.",
       "Look at it. That's what untrained fire does. It doesn't open things. It ends them.",
       "Rest. Tomorrow, we do it again."
      ]
     },
     {
      "when": {
       "all": [
        {
         "any": [
          {
           "signal": {
            "obj": "TestRoom_Barricade_01",
            "name": "raised"
           }
          },
